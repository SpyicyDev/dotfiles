bind R new-window -a -c "#{pane_current_path}" \; kill-window -t -

# CTRL+CMD+T (wezterm) → new tab running nushell, same cwd. The data tab:
# JSON/yabai introspection, config surgery, API poking. $SHELL is untouched
# (still zsh), so this changes nothing outside the tab.
