# Agent tab indicator (see docs/agent-tab-indicator.md). Claude Code / Codex
# hooks + scripts/agent-tab-watcher.sh maintain per-window options
# @agent_state (idle|running|needs-input|failed|done), @agent_summary,
# @agent_workflow (background Claude Workflow in flight) and @agent_cua (the
# agent is driving an app through cua-driver); the Catppuccin window formats
# below render them.
#
# THREE CHANNELS. Each tab says three independent things, one per surface:
#   NUMBER CHIP ($color)      motion — is this window in flight right now?
#   TAB BODY    ($background) attention tier — does it want you? (green/
#                             yellow/red fill, ambient states leave it stock)
#   GLYPH SLOT  (text)        the exception — a job the chip alone can't
#                             describe: 󰒓 background workflow, 󰍽 computer use.
#                             EMPTY for idle and for an ordinary running turn.
# There is deliberately no "an agent lives here" marker anymore (the old mauve
# robot): an idle agent tab is a stock blue tab. Presence is still legible from
# the tab NAME, which reads project/short-title for agent windows and #W
# (zsh, nvim, …) for everything else.
#
# SHARED PALETTE — these hues are the tab-bar half of one agent-state color
# language; CuaNotch's glow renders the SAME state in the same hue, saturated
# for light instead of pastel-on-dark (see the memory note / CuaNotch.swift):
#   idle/ready      grey   #6c7086  ·  notch: no glow at all
#   working         pink   #f5c2e7  ·  notch magenta #FF4FD1  (subtle)
#   computer use    blue   #89b4fa  ·  notch blue   #408CFF   (full)
#   needs approval  red    #f38ba8  ·  notch red    #FF4740   (full)
#   waiting input   yellow #f9e2af  ·  notch amber  #FF9E26   (full)
#   done, unvisited green  #a6e3a1  ·  notch green  #33E673   (full→subtle)
#   workflow        teal   #94e2d5  ·  notch: (none)
# Emphasis tiers match too: the states that WANT YOU (approval/input/done)
# fill the whole tab, exactly as they burn at full strength in the glow;
# ambient states (working/cua/idle) never touch the body, as they glow subtly.
# Motion means the same thing in both: pulsing = in flight, steady = waiting
# on you. Don't reassign a hue in one surface without the other.
#
# ONE EXCEPTION to "same hue everywhere": blue #89b4fa is BOTH catppuccin's
# resting chip accent and the computer-use hue. On the chip, blue therefore
# reads as "at rest", so the working pulse pink↔blue reads as working↔resting
# rather than as a third state — and computer use is carried by the 󰍽 glyph in
# the state's blue instead. That is why cua lives in the glyph slot and not in
# the chip.
#
# Background tint: Catppuccin pastes @catppuccin_window_*_background verbatim
# into ALL FOUR tab segments that use $background (number fg, middle-sep bg,
# text bg, right-sep fg), so injecting a per-window conditional here tints the
# whole tab consistently — tinting only the text segment would leave stale
# separator end-caps. The expression must stay space-free and quote-free
# (catppuccin's option batch reader splits on spaces and strips quotes).
# Mocha: done=green #a6e3a1, failed=red #f38ba8, needs-input=yellow
# #f9e2af. running/cua get NO bg change (ambient tier — their signal is the
# pulsing number chip in the $color options below). A
# done tab with a background workflow still in flight is NOT tinted green
# (it isn't really finished) — it falls back to stock and the blinking gear
# glyph carries the signal. No-state fallbacks (catppuccin stock): SELECTED
# tab sits on base #1e1e2e (blends into the status bar) and unselected tabs
# get the surface0 #313244 gray pill.
#
# SLEEPING (@agent_nap, set for both `sleeping` and `waking` — see nap.sh) is
# the outermost test on all six options below, because it is the one state
# where no process exists at all: it cannot coexist with running, cua, a
# workflow, or an attention state, so nothing it shadows can be live. It is the
# ANTI-attention state — the tab must recede, never pull. Hence base #1e1e2e
# here, which is stock catppuccin's SELECTED background precisely because it
# blends into the status bar (see the no-state fallback note above).
# The choice was measured, not picked: $background is also the window NUMBER's
# fg under fill=number, so it has to read against the overlay0 #6c7086 chip
# while leaving the title recessed. crust #11111b gives a fine 3.84x digit but
# lifts the title to 5.07x (too bright for something asleep); stock surface0
# #313244 recesses the title nicely at 3.40x but drops the digit to 2.57x —
# muddy, and the digit is how you jump to the tab. base #1e1e2e is the only
# option that wins both: digit 3.36x, title 4.44x — about half the 8.69x of a
# normal tab, which is what "greyed out" should measure.
set -g @catppuccin_window_default_background "#{?@agent_nap,#1e1e2e,#{?#{==:#{@agent_state},done},#{?#{@agent_workflow},#313244,#a6e3a1},#{?#{==:#{@agent_state},failed},#f38ba8,#{?#{==:#{@agent_state},needs-input},#f9e2af,#313244}}}}"
set -g @catppuccin_window_current_background "#{?@agent_nap,#1e1e2e,#{?#{==:#{@agent_state},done},#{?#{@agent_workflow},#1e1e2e,#a6e3a1},#{?#{==:#{@agent_state},failed},#f38ba8,#{?#{==:#{@agent_state},needs-input},#f9e2af,#1e1e2e}}}}"

# fill=number locks the window NUMBER's fg to the $background expression
# above (number block is `#[fg=$background,bg=$color]#I`), which would put a
# pastel digit on the blue/orange accent — illegible (WCAG CR 1.2-1.7). Darken
# the accent ($color: also the left cap and middle-sep stroke) to crust
# #11111b on attention states so the state-colored digit reads against it.
#
# $color is ALSO the motion channel: an UNSELECTED tab whose window is in
# flight (running || cua || workflow) pulses its number chip pink #f5c2e7 ↔
# blue #89b4fa at 1 s, driven by the same global @agent_blink the watcher
# already toggles. Blue is the resting accent, so the pulse reads as
# working↔resting.
#
# PINK, not mauve (2026-08-19 — mauve read as too subtle, and the numbers say
# why): mauve #cba6f7 and blue #89b4fa have near-identical relative luminance
# (0.467 vs 0.449) and sit in the same blue-violet family, so the pulse moved
# hue only and barely registered. Pink is L 0.638 — a 1.42:1 BRIGHTNESS step
# on top of a ~100° hue swing, so the chip visibly lightens as well as shifts.
# It is also the only mocha hue left: lavender/sky/sapphire are the blue
# family (mauve's failure, worse), rosewater/flamingo/maroon are the red
# family. Pink sits 27° off failure red #f38ba8, which sounds close but
# cannot collide — attention states force the chip to CRUST, so a red chip and
# a pink chip never exist on the same surface (and pink is far lighter, 0.638
# vs 0.404). Digit contrast improves too: 8.2:1 on pink vs 6.2:1 on mauve.
# Priority: attention beats motion — needs-*/done force crust
# regardless, because the digit's own fg is the bright body tint and needs a
# dark chip to read at all. (A permission prompt raised while a background
# workflow runs is therefore a red tab with a still chip and a gear glyph.)
# done+workflow is not tinted, so it pulses like any other in-flight window.
# The SELECTED tab never pulses: it is solid peach for every ambient state —
# you are looking at it, the terminal itself is the progress indicator, and a
# blinking chip under your cursor is just noise.
#
# A sleeping tab takes overlay0 #6c7086 and — the point — is the one agent
# state that NEVER pulses. Motion here means "in flight"; a slept session is
# the furthest thing from in flight, so it sits perfectly still. That also
# keeps it out of the blink budget: @agent_blink is only toggled while
# something is genuinely running, and nothing about a nap re-arms it.
set -g @catppuccin_window_default_color "#{?@agent_nap,#6c7086,#{?#{==:#{@agent_state},done},#{?#{@agent_workflow},#{?#{@agent_blink},#f5c2e7,#89b4fa},#11111b},#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{@agent_workflow},#{?#{@agent_blink},#f5c2e7,#89b4fa},#{?#{@agent_cua},#{?#{@agent_blink},#f5c2e7,#89b4fa},#{?#{==:#{@agent_state},running},#{?#{@agent_blink},#f5c2e7,#89b4fa},#89b4fa}}}}}}"
set -g @catppuccin_window_current_color "#{?@agent_nap,#6c7086,#{?#{==:#{@agent_state},done},#{?#{@agent_workflow},#fab387,#11111b},#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#fab387}}}"

# Tab text: the glyph slot, then the summary. The slot is EXCEPTIONS ONLY —
# priority background workflow > computer use > nothing. Ordinary states
# (idle, running, and every attention state) render NO glyph: the chip pulse
# says "in flight" and the body tint says "wants you", so a robot or a ● would
# only restate what the colors already carry, and both cost 2 cells.
#   󰒓 (nf-md-cog U+F0493)   teal #94e2d5 — a background Workflow outliving the
#                           turn; the one thing no other channel encodes.
#   󰍽 (nf-md-mouse U+F037D) blue #89b4fa — the agent is driving an app through
#                           cua-driver (see the palette note above for why cua
#                           lives here and not in the chip).
# The slot is EXCLUSIVE and the gear wins: a session both driving an app and
# running a workflow shows only 󰒓. Deliberate, and deliberately asymmetric with
# CuaNotch, where a workflow is an OVERLAY that composes with the state and the
# popup row shows both (blue dot + teal gear). The gear is the one that must
# survive — it is the ONLY carrier of "a fleet is still out" and it outlives the
# turn, so dropping it lets a finished-looking tab hide live work; the mouse
# only refines a chip that is already pulsing "in flight". Both glyphs (4 cells)
# was considered and rejected: double the width jitter for a rare pair, and the
# notch popup is the detail surface for precisely this case.
# agent-tab-watcher.sh toggles the global @agent_blink each second while
# anything is running/driving/workflowing; each pulsing glyph alternates
# between its hue and a ~68% BRIGHTNESS copy of that same hue (dim blue
# #5d7aaa, dim teal #659a91). Never blink a GLYPH between two different hues:
# mid-pulse it then reads as some other state (this is why the chip, whose
# resting blue means "no agent working", can pulse mauve↔blue and a glyph
# cannot). On a TINTED tab the glyph goes crust #11111b and stops pulsing —
# teal on yellow/red is unreadable, and a tab already at maximum urgency does
# not need a second animation. Then a fg readable on the bright attention
# backgrounds (crust #11111b; light #cdd6f4 when a workflow suppressed the
# done tint), then the agent summary ("project/short title") with #W fallback.
# Tabs are NOT width-stabilised: the slot's 2 cells appear and vanish with the
# workflow/cua flags and shove later tabs. Deliberate — those flags flip rarely
# (once per workflow, not per turn), and reserving a blank for every agent
# window would pad the common case to pay for the rare one.
set -g @catppuccin_window_default_text "#{?@agent_nap,#[fg=#7f849c]󰒲 #{?#{n:#{@agent_summary}},#{@agent_summary},#W},#{?#{@agent_workflow},#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{@agent_blink},#94e2d5,#659a91}}]󰒓 ,#{?#{@agent_cua},#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{==:#{@agent_state},done},#11111b,#{?#{@agent_blink},#89b4fa,#5d7aaa}}}]󰍽 ,}}#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{@agent_workflow},#cdd6f4,#{?#{==:#{@agent_state},done},#11111b,#cdd6f4}}}]#{?#{n:#{@agent_summary}},#{@agent_summary},#W}}"
set -g @catppuccin_window_current_text "#{?@agent_nap,#[fg=#7f849c]󰒲 #{?#{n:#{@agent_summary}},#{@agent_summary},#W},#{?#{@agent_workflow},#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{@agent_blink},#94e2d5,#659a91}}]󰒓 ,#{?#{@agent_cua},#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{==:#{@agent_state},done},#11111b,#{?#{@agent_blink},#89b4fa,#5d7aaa}}}]󰍽 ,}}#[fg=#{?#{||:#{m:needs-*,#{@agent_state}},#{==:#{@agent_state},failed}},#11111b,#{?#{@agent_workflow},#cdd6f4,#{?#{==:#{@agent_state},done},#11111b,#cdd6f4}}}]#{?#{n:#{@agent_summary}},#{@agent_summary},#W}}"
# end catppuccin

# Agent tab indicator runtime: presence/GC watcher daemon (singleton), and
# focus discharges a tab's attention state (needs-input/done → idle) the
# moment you switch to it. NOTE: this occupies after-select-window[0]; new
# handlers must use explicit indices ([1]+) or they'll overwrite this one.
run-shell -b "bash #{HOME}/.config/tmux/scripts/agent-tab-watcher.sh"
set-hook -g after-select-window 'run-shell -b "#{HOME}/.config/tmux/scripts/agent-tab-indicator.sh clear-current #{window_id}"'
# CuaNotch (notch glow indicator): instant visit acknowledgment — dismisses a
# finished agent's green / subsides a needs-input blaze the moment its tab is
# focused. Explicit [1] index to coexist with agent-tab-indicator above.
set-hook -g 'after-select-window[1]' 'run-shell -b "#{HOME}/.local/bin/cua-notch-visit"'
set-hook -g 'after-select-pane[1]' 'run-shell -b "#{HOME}/.local/bin/cua-notch-visit"'
set-hook -g 'client-session-changed[1]' 'run-shell -b "#{HOME}/.local/bin/cua-notch-visit"'

# Session nap: terminate an idle Claude session but keep its tab, and resume it
# in place on return. Four idle agent tabs measured ~4.0 GB RSS and ~7% CPU
# doing nothing; sleeping them gives that back. SIGSTOP was tried first and
# rejected — it frees no memory and leaves the TUI permanently unable to read
# input (see the header of nap.sh for the measurements).
#
# prefix+S sleep · prefix+W wake · prefix+Z pin (never auto-sleep).
# All three verified unbound in every key table before claiming them: the
# obvious prefix+s and prefix+w are choose-tree, and prefix+P is tmux-floax.
# W and b appear in copy-mode-vi as word motions, which do not collide with the
# prefix table.
bind-key S run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh sleep '#{window_id}'"
bind-key W run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh wake '#{window_id}'"
bind-key Z run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh pin '#{window_id}'"
bind-key M-s run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh sleep-idle 0"

# Auto-wake on arrival. Deliberately after-select-window and NOT pane-focus-in:
# the latter also fires when the terminal itself regains focus, so merely
# alt-tabbing back would rehydrate a session you never asked for. This fires
# only on a real tab switch. Explicit [2] — [0] is agent-tab-indicator and [1]
# is cua-notch-visit; an unindexed handler would silently overwrite [0].
# nap.sh debounces internally (NAP_FOCUS_DEBOUNCE, default 2s) and re-checks
# that the window is still the one being looked at, so passing through a tab on
# the way somewhere else does not pay for a rehydrate — which matters, because
# wake latency scales with transcript size and the largest session here is
# 20 MB / 5592 messages.
set-hook -g 'after-select-window[2]' 'run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh wake-on-focus #{window_id}"'
set-hook -g 'client-session-changed[2]' 'run-shell -b "#{HOME}/.config/tmux/scripts/nap.sh wake-on-focus #{window_id}"'

# Fork of tmux-plugins/tmux-resurrect. Its ONLY functional change is
# strategies/nvim_session.sh: upstream looks for a `Session.vim` in the pane's
# cwd (the tpope/vim-obsession convention), but we use folke/persistence.nvim,
# which writes to ~/.local/state/nvim/sessions/ with `/` encoded as `%`. Upstream
# therefore never matched a session file and restored a bare `nvim` with no
# buffers; the fork reads persistence.nvim's layout and emits `nvim -S <file>`.
# Upstream has been frozen since 2023-03; the fork is 0 behind / 4 ahead of it.
# Safe swap: resurrect self-registers @resurrect-{save,restore}-script-path from
# its own $CURRENT_DIR, so continuum and tmux-assistant-resurrect (which couple
# only through tmux options, not the plugin dir name) follow automatically.
set -g @plugin 'trevin-j/tmux-resurrect-nvim'
set -g @resurrect-dir '{{ .chezmoi.homeDir }}/.tmux/resurrect'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-nvim 'session'
# Restore nu tabs as nu, not as the default shell. A `bind N` window runs nu as
# its command rather than a shell, so without this resurrect sees an unlisted
# process and respawns the pane with $SHELL (zsh) — the tab would come back
# silently demoted. @resurrect-processes APPENDS to the built-in default list
# (see _restore_list in scripts/process_restore_helpers.sh), so the defaults
# for nvim/less/htop/etc. are preserved.
set -g @resurrect-processes 'nu'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-save-interval '15'
set -g @continuum-restore 'on'

# Persist and resume assistant CLI sessions with tmux-resurrect/continuum.
set -g @plugin 'timvw/tmux-assistant-resurrect'
set -g @assistant-resurrect-capture-env 'VIRTUAL_ENV NODE_ENV CONDA_DEFAULT_ENV OPENCODE_CONFIG'

unbind-key a
bind-key a display-popup -E -w 60% -h 75% "$HOME/.config/tmux/scripts/mru-session-switch.sh"

unbind-key C-a
bind-key C-a display-popup -E -w 60% -h 75% "$HOME/.config/tmux/scripts/mru-session-switch.sh"

set -g @plugin '27medkamal/tmux-session-wizard'
set -g @session-wizard 'T'

set -g @plugin 'sainnhe/tmux-fzf'
TMUX_FZF_LAUNCH_KEY="C-m"

set -g @plugin 'omerxx/tmux-floax'
set -g @floax-bind '-n M-q'

unbind -n M-a
bind -n M-a run-shell -b "#{HOME}/.config/tmux/scripts/toggle-btop-popup.sh '#{client_tty}'"

